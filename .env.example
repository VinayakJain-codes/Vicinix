# ==========================================
# Vicinix EmailJS Configuration
# Form submissions are routed to: vinayakjain2110@gmail.com
# Dashboard: https://dashboard.emailjs.com/
# ==========================================

# Your EmailJS Service ID (e.g. service_xxxxxxx from Email Services tab)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=

# Your EmailJS Public Key (from Account > API Keys > Public Key)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Your default EmailJS Template ID (e.g. template_xxxxxxx from Email Templates tab)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=

# Target Recipient Email (default: vinayakjain2110@gmail.com)
NEXT_PUBLIC_EMAILJS_TO_EMAIL=vinayakjain2110@gmail.com

# (Optional) You can provide distinct templates for each form if desired:
# NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=template_contact_xxx
# NEXT_PUBLIC_EMAILJS_CUSTOM_SOFTWARE_TEMPLATE_ID=template_custom_software_xxx
# NEXT_PUBLIC_EMAILJS_ENQUIRE_TEMPLATE_ID=template_custom_software_xxx
